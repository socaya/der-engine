# DER pilot environment — copy to /etc/der/pilot.env and tune per site.
#
# Keep this file 0640, owner root, group der. Rotate DER_BOOTSTRAP_ADMIN_PASSWORD
# after first boot (admin changes password via EA-02).

# --- Spring + server ---
SERVER_PORT=8085
SPRING_PROFILES_ACTIVE=pilot

# --- Datasource ---
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/der
SPRING_DATASOURCE_USERNAME=der
SPRING_DATASOURCE_PASSWORD=change-me-pilot

# --- DHIS2 central (outbound only) ---
DER_DHIS2_CENTRAL_URL=https://central.example.org
DER_DHIS2_CENTRAL_TOKEN=change-me-dhis2-token
DER_DHIS2_REFERENCE_VERSION=2.44

# --- Bootstrap admin (used once; disable after rotation) ---
DER_BOOTSTRAP_ADMIN_USERNAME=admin
DER_BOOTSTRAP_ADMIN_PASSWORD=change-me-boot
DER_BOOTSTRAP_ADMIN_DISPLAY_NAME="Pilot Admin"

# --- Backup / restore (ADR-0012) ---
DER_BACKUP_ENABLED=true
DER_BACKUP_LOCAL_ROOT=/var/lib/der/backups
DER_BACKUP_UPLOAD_ROOT=/var/lib/der/uploads
DER_BACKUP_PG_DUMP=/usr/bin/pg_dump
DER_BACKUP_PG_RESTORE=/usr/bin/pg_restore
DER_BACKUP_LOCAL_MAX_ARCHIVES=50
DER_BACKUP_TIMEOUT_SECONDS=900
# Optional offsite (S3-compatible). Leave blank to keep archives local-only.
DER_BACKUP_REMOTE_URL=
DER_BACKUP_REMOTE_BEARER=

# --- Journal / scheduler cron overrides (ADR-0008/0010) ---
DER_JOURNAL_DRAIN_CRON=0 * * * * ?
DER_SYNC_METADATA_CRON=0 0 */4 * * ?
DER_SYNC_COMPAT_CRON=0 0 3 * * ?
DER_SYNC_DRIFT_CRON=0 10 */4 * * ?
DER_BACKUP_DRAIN_CRON=0 */15 * * * ?

# --- JVM ---
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1536m -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError
