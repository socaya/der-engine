                    <exclude>ug.ac.mak.der.web.NetworkController.StateChange</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.StaticLeaseBody</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.TokenBody</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkTopologyController</exclude>
                    <exclude>ug.ac.mak.der.web.OperationsAdminController</exclude>
                    <exclude>ug.ac.mak.der.web.OperationsAdminController.BackupTriggerRequest</exclude>
                    <exclude>ug.ac.mak.der.web.OperationsAdminController.DecommissionRequest</exclude>
                    <exclude>ug.ac.mak.der.web.OperationsAdminController.RetryBatchRequest</exclude>
                    <exclude>ug.ac.mak.der.web.OperationsAdminController.SettingsRequest</exclude>
                    <exclude>ug.ac.mak.der.web.OperatorMetricsController</exclude>
                    <exclude>ug.ac.mak.der.web.PackagingController</exclude>
                    <exclude>ug.ac.mak.der.web.PeerLifecycleController</exclude>
                    <exclude>ug.ac.mak.der.web.PeerLifecycleController.InviteBody</exclude>
                    <exclude>ug.ac.mak.der.web.PeerLifecycleController.RedeemBody</exclude>
