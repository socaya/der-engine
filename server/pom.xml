                    <exclude>ug.ac.mak.der.web.DeviceController</exclude>
                    <exclude>ug.ac.mak.der.web.DeviceController.AdjacencyRequest</exclude>
                    <exclude>ug.ac.mak.der.web.DeviceController.ProfileRequest</exclude>
                    <exclude>ug.ac.mak.der.web.DeviceMessageController</exclude>
                    <exclude>ug.ac.mak.der.web.DeviceMessageController.CursorBody</exclude>
                    <exclude>ug.ac.mak.der.web.DeviceMessageController.KeysBody</exclude>
                    <exclude>ug.ac.mak.der.web.DeviceMessageController.PublishBody</exclude>
