                    <!-- dhis2 + dhis2emulator + metadata: untested since
                         Phase 03 refactor; indirect coverage via
                         MetadataSyncService integration tests. -->
                    <exclude>ug.ac.mak.der.dhis2.Dhis2ConnectionConfigRepository</exclude>
                    <exclude>ug.ac.mak.der.dhis2emulator.AppsListController</exclude>
                    <exclude>ug.ac.mak.der.dhis2emulator.Dhis2ApiProxyController</exclude>
                    <exclude>ug.ac.mak.der.dhis2emulator.MetadataListController</exclude>
                    <exclude>ug.ac.mak.der.metadata.MetadataCatalogRepository</exclude>
