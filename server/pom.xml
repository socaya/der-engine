                    <exclude>ug.ac.mak.der.web.MetadataSnapshotController</exclude>
                    <exclude>ug.ac.mak.der.web.MfaController</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.ApBody</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.ClientBody</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.EnrolBody</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.InterfaceBody</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.PeerBody</exclude>
                    <exclude>ug.ac.mak.der.web.NetworkController.PolicyBody</exclude>
