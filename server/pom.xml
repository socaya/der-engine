                    <exclude>ug.ac.mak.der.web.Dhis2ConnectionController</exclude>
                    <exclude>ug.ac.mak.der.web.DraftController</exclude>
                    <exclude>ug.ac.mak.der.web.DraftController.2</exclude>
                    <exclude>ug.ac.mak.der.web.EdgeSystemInfoController</exclude>
                    <exclude>ug.ac.mak.der.web.EnrollmentController</exclude>
                    <exclude>ug.ac.mak.der.web.EnrollmentController.UpsertRequest</exclude>
                    <exclude>ug.ac.mak.der.web.FleetController</exclude>
                    <exclude>ug.ac.mak.der.web.FleetController.PrefBody</exclude>
