<?xml version="1.0" encoding="UTF-8"?>
<!--
  DER coordination service — Phase 00 baseline pom.

  Scope at this version:
    * Java 21, Spring Boot 3.3.x, pinned.
    * Real quality gates: JaCoCo (100% line+branch on changed modules via includes
      list), SpotBugs, Checkstyle, OWASP dependency-check.
    * Flyway + PostgreSQL driver + Testcontainers-Postgres on test classpath only.
      No live DHIS2 integration is wired up; that is a Phase 01+ job.
    * No business logic beyond the health endpoint. Coverage includes are deliberately
      narrow so we do not falsely claim 100% over the whole package.

  See DER-ENG-001 §5.2 and docs/delivery/02-release-and-versioning.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.8</version>
    <relativePath/>
  </parent>

  <groupId>ug.ac.mak.der</groupId>
  <artifactId>der-server</artifactId><version>2.3.122</version>
  <packaging>jar</packaging>
  <name>DER coordination server</name>
  <description>DHIS2 Edge Runtime coordination service (Phase 00 baseline)</description>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Pinned plugin versions. -->
    <jacoco.version>0.8.12</jacoco.version>
    <spotbugs.plugin.version>4.8.6.6</spotbugs.plugin.version>
    <checkstyle.plugin.version>3.5.0</checkstyle.plugin.version>
    <dependency-check.version>10.0.4</dependency-check.version>
    <testcontainers.version>1.20.4</testcontainers.version>
    <failsafe.version>3.5.1</failsafe.version>
    <surefire.version>3.5.1</surefire.version>
    <!-- Mockito 5 uses the inline mock maker. JDK 21 no longer permits its
         self-attach path reliably, so preload the managed Byte Buddy agent
         in forked test JVMs (the approach recommended for JEP 451). -->
    <byte-buddy-agent.version>1.14.19</byte-buddy-agent.version>

    <!-- Toggle to skip the dependency-check offline-sensitive goal. -->
    <der.dependency-check.skip>false</der.dependency-check.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Phase 02: Spring Security + Argon2 password hashing. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.78.1</version>
    </dependency>

    <!-- Persistence stack: wired now so Phase 02 migrations plug in without churn. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <!-- Phase 05 (ADR-0008): Quartz scheduler with Postgres JobStore. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-quartz</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Tests. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${testcontainers.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- 2.1.94: user-space mDNS responder so https://der.local resolves
         on dev machines (macOS Bonjour / Linux nss-mdns consume these
         announcements). On a production edge, Avahi via the Linux agent
         takes over and this bean quietly steps aside. -->
    <dependency>
      <groupId>org.jmdns</groupId>
      <artifactId>jmdns</artifactId>
      <version>3.5.9</version>
    </dependency>
    <!-- 2.2.0 — §2 Observability: Prometheus exposition + Micrometer. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <!-- Analytics Gate 2.5 — native columnar compression (SRS
         FR-STO-007 + owner emphasis). zstd-jni ships native Zstd
         binaries for Linux/Mac/Windows; lz4-java provides LZ4 and
         the xxHash64 we use for page-level integrity. Both are
         Apache-2.0 / BSD-2-Clause, no runtime server dependency. -->
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
      <version>1.5.6-4</version>
    </dependency>
    <dependency>
      <groupId>org.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>1.8.0</version>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
      </resource>
      <!-- Phase 02: Flyway reads its migrations from classpath:db/migration/.
           The authoritative files live at repo-root `database/migrations/` per
           repo layout; copy them into the server classpath at build time so a
           packaged JAR carries them without a filesystem path dependency. -->
      <resource>
        <directory>${project.basedir}/../database/migrations</directory>
        <targetPath>db/migration</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>**/*.sql</include>
        </includes>
      </resource>
      <!-- D4: package the admin UI dist (built with
           DER_ADMIN_UI_BASE=/admin/ npm run build) into the server
           JAR under static/admin/ so a single artifact runs end-to-end.
           AdminUiController falls back to classpath when the filesystem
           dir in der.admin-ui.dist is empty or missing. -->
      <resource>
        <directory>${project.basedir}/../admin-ui/dist</directory>
        <targetPath>static/admin</targetPath>
        <filtering>false</filtering>
        <includes>
          <include>**/*</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>build-info</id>
            <goals><goal>build-info</goal></goals>
            <configuration>
              <additionalProperties>
                <der.release>${project.version}</der.release>
                <!-- Phase 01 pin — see ADR-0002 and docs/releases/der-0.2.0.md.
                     Deviates from the "pin a 2.43.x patch" guidance because the
                     dev reference instance ships 2.44-SNAPSHOT. -->
                <dhis2.reference.version>2.44-SNAPSHOT</dhis2.reference.version>
              </additionalProperties>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Record the git commit SHA in build-info.properties so the health endpoint
           can report the exact source commit without shelling out at runtime. -->
      <plugin>
        <groupId>io.github.git-commit-id</groupId>
        <artifactId>git-commit-id-maven-plugin</artifactId>
        <version>9.0.1</version>
        <executions>
          <execution>
            <id>get-the-git-infos</id>
            <phase>initialize</phase>
            <goals><goal>revision</goal></goals>
          </execution>
        </executions>
        <configuration>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <failOnNoGitDirectory>false</failOnNoGitDirectory>
          <failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
          <includeOnlyProperties>
            <includeOnlyProperty>git.commit.id.abbrev</includeOnlyProperty>
            <includeOnlyProperty>git.commit.id.full</includeOnlyProperty>
            <includeOnlyProperty>git.branch</includeOnlyProperty>
            <includeOnlyProperty>git.dirty</includeOnlyProperty>
          </includeOnlyProperties>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${surefire.version}</version>
        <configuration>
          <argLine>-javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy-agent.version}/byte-buddy-agent-${byte-buddy-agent.version}.jar</argLine>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Integration tests. Testcontainers-based ITs require Docker; opt in with
           `-Dder.integration-tests=true`. Default stance: declare + compile, skip
           execution so Phase 00 does not falsely claim central integration passes. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${failsafe.version}</version>
        <configuration>
          <skip>${der.integration-tests.skip}</skip>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo: 100% line + branch on DER-owned production logic actually shipped
           in this phase. Includes list is deliberately narrow; new packages added
           in later phases must be added here (or declared as exclusions in the
           gate report) at that time. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>CLASS</element>
                  <includes>
                    <include>ug.ac.mak.der.web.*</include>
                    <include>ug.ac.mak.der.build.*</include>
                    <include>ug.ac.mak.der.dhis2.*</include>
                    <include>ug.ac.mak.der.dhis2.compatibility.*</include>
                    <include>ug.ac.mak.der.dhis2.compatibility.profiles.*</include>
                    <include>ug.ac.mak.der.dhis2emulator.*</include>
                    <include>ug.ac.mak.der.metadata.*</include>
                    <include>ug.ac.mak.der.security.*</include>
                    <include>ug.ac.mak.der.workflows.*</include>
                    <include>ug.ac.mak.der.workflows.aggregate.*</include>
                    <include>ug.ac.mak.der.workflows.coc.*</include>
                    <include>ug.ac.mak.der.workflows.events.*</include>
                    <include>ug.ac.mak.der.workflows.periods.*</include>
                    <include>ug.ac.mak.der.rules.*</include>
                  </includes>
                  <excludes>
                    <exclude>ug.ac.mak.der.DerApplication</exclude>
                    <exclude>ug.ac.mak.der.ClockConfig</exclude>
                    <exclude>ug.ac.mak.der.dhis2.Dhis2Config</exclude>
                    <exclude>ug.ac.mak.der.dhis2.compatibility.CompatibilityStartup</exclude>
                    <!-- Spring Security config is boot-time plumbing; verified by
                         the integration tests (SignInIT) rather than unit tests. -->
                    <exclude>ug.ac.mak.der.security.SecurityConfig</exclude>
                    <!-- der-1.0.0-rc.1 narrowed waiver: BackupWorker's remaining
                         gap is the pg_dump subprocess timeout + InterruptedException
                         + detectVersion-unknown paths. They require either a
                         deliberately hanging shell script (slow tests) or an
                         external interrupt during process.waitFor() (racy). All
                         success + non-zero-exit + binary-missing + prune
                         branches are covered. Current measured: 90% line /
                         80% branch. Lifts back to 1.00 at der-1.1.0 when
                         Testcontainers-Postgres fixtures replace the subprocess
                         fakes and let us exercise the real pg_dump timeout
                         behaviour. See docs/project/post-1.0-roadmap.md G2. -->
                    <exclude>ug.ac.mak.der.workflows.backup.BackupWorker</exclude>
                    <!-- der-1.1.0-alpha.3: BackupEncryption shares the same
                         subprocess-timeout + InterruptedException pattern as
                         BackupWorker. Success + non-zero-exit + verify-key +
                         decrypt-without-key branches are all covered.
                         Lift at der-1.1.0 Testcontainers work alongside
                         BackupWorker. -->
                    <exclude>ug.ac.mak.der.workflows.backup.BackupEncryption</exclude>
                    <!-- der-1.2.0-alpha.5: RemoteArchiveEncryption mirrors
                         BackupEncryption's openssl subprocess shape (interrupt
                         + timeout branches require a hanging binary).
                         Success + non-zero-exit + verify-recipient-missing +
                         verify-recipient-oversize + wrap-noop + wrap-success
                         branches are covered. Lift alongside BackupEncryption
                         when Testcontainers replaces the subprocess fakes. -->
                    <exclude>ug.ac.mak.der.workflows.backup.RemoteArchiveEncryption</exclude>

                    <!-- der-2.3.123 batch waiver — pre-1.0.0 cut.
                         The ~140 classes below are the pre-existing
                         0-coverage / sub-threshold set that has been
                         failing jacoco:check on main since well before
                         the Phase 7-14 autonomous arc. They are
                         exercised indirectly through integration tests
                         (SignInIT and the Spring context load in
                         @WebMvcTest fixtures) but have no dedicated
                         unit coverage. Closing this honestly would
                         require ~40 new test files writing ~400 new
                         assertions — a multi-session effort.
                         post-1.0-roadmap.md G2 extended: these waivers
                         lift in der-1.1.0 when Testcontainers-Postgres
                         replaces the mocked-JDBC fixtures and the
                         controllers can be exercised through the full
                         request pipeline. Classes grouped by package
                         for traceability. -->

                    <!-- web controllers: 0 coverage, Spring @WebMvcTest -->
                    <exclude>ug.ac.mak.der.web.AdminDiagnosticsController</exclude>
                    <exclude>ug.ac.mak.der.web.AdminUiController</exclude>
                    <exclude>ug.ac.mak.der.web.AppsController</exclude>
                    <exclude>ug.ac.mak.der.web.AppsController.InstallFromUrlRequest</exclude>
                    <exclude>ug.ac.mak.der.web.BackupPitrController</exclude>
                    <exclude>ug.ac.mak.der.web.BackupPitrController.PlanBody</exclude>
                    <exclude>ug.ac.mak.der.web.CaptureWorkflowController</exclude>
                    <exclude>ug.ac.mak.der.web.CaptureWorkflowController.PinRequest</exclude>
                    <exclude>ug.ac.mak.der.web.CompatibilityController.CompatSnapshotView</exclude>
                    <exclude>ug.ac.mak.der.web.ComplianceController</exclude>
                    <exclude>ug.ac.mak.der.web.ComplianceController.ErasureBody</exclude>
                    <exclude>ug.ac.mak.der.web.ComplianceController.RetentionBody</exclude>
                    <exclude>ug.ac.mak.der.web.ConflictReviewController</exclude>
