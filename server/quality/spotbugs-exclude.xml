<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for the DER coordination service.

  Add a <Match> block only with a reviewer-approved rationale documented inline.
  Entries without rationale are not permitted; empty file means zero suppressions.
-->
<FindBugsFilter>
  <!-- Generated by Spring Boot auto-configuration; the main() signature is
       mandated by Spring. The nested-class static-method rule does not apply. -->
  <Match>
    <Class name="ug.ac.mak.der.DerApplication"/>
    <Bug pattern="DM_EXIT"/>
  </Match>

  <!-- Phase 02 records expose their collection components by design: Jackson
       drives serialisation and never mutates return values; controllers that
       accept CreateUserRequest copy into an EnumSet before use. The underlying
       lists are either List.copyOf (immutable from Jackson 2.14+) or
       EnumSet-backed; SpotBugs cannot see Jackson's intent, so EI_EXPOSE_REP /
       EI_EXPOSE_REP2 are suppressed on these records only. Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.security.EdgeUser"/>
      <Class name="ug.ac.mak.der.web.AuthController$SignInResponse"/>
      <Class name="ug.ac.mak.der.web.ProvisioningController$CreateUserRequest"/>
      <Class name="ug.ac.mak.der.web.ProvisioningController$UserResponse"/>
      <Class name="ug.ac.mak.der.web.ProvisioningController$ListResponse"/>
      <Class name="ug.ac.mak.der.web.ActivityController$RecentActivityResponse"/>
      <Class name="ug.ac.mak.der.dhis2emulator.DataValueSetsController$DataValueSetsRequest"/>
      <Class name="ug.ac.mak.der.workflows.aggregate.AggregateDataValueService$ImportSummary"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- EdgeUserPrincipal implements Serializable (per Spring Security's
       AbstractAuthenticationToken) but DER sessions are never serialised to
       disk; the opaque token on the client is independent of Java
       serialisation. transient-not-restored is therefore an intentional
       design choice. Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.security.EdgeUserPrincipal"/>
    <Bug pattern="SE_TRANSIENT_FIELD_NOT_RESTORED"/>
  </Match>

  <!-- Controllers receive stateful Spring beans managed by the container.
       The 'externally mutable' pattern does not apply — the fields are the
       single-instance managed beans the controller is wired against.
       Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.web.ProvisioningController"/>
      <Class name="ug.ac.mak.der.web.MetadataSyncController"/>
      <Class name="ug.ac.mak.der.web.BackupController"/>
      <Class name="ug.ac.mak.der.web.RestoreController"/>
      <Class name="ug.ac.mak.der.dhis2emulator.MetadataListController"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!-- Postgres RETURNING always produces exactly one row from upsert; the
       Objects.requireNonNull wraps the JdbcTemplate contract to make that
       explicit. SpotBugs cannot see the guarantee. Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.workflows.aggregate.AggregateDataValueRepository"/>
    <Method name="upsert"/>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>

  <!-- ADR-0006 compatibility engine: the capability JSONB column can carry
       any shape DER has written in prior releases, so JSON parsing is
       deliberately broad-catch-and-wrap into SQLException. Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.dhis2.compatibility.CapabilitySnapshotRepository"/>
    <Or>
      <Method name="readCapabilities"/>
      <Method name="readProbe"/>
    </Or>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!-- Fail-closed registry construction: throw rather than build an
       unusable registry. Not a concern for subclassing (final-equivalent
       state). Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.dhis2.compatibility.Dhis2ProfileRegistry"/>
    <Method name="&lt;init&gt;"/>
    <Bug pattern="CT_CONSTRUCTOR_THROW"/>
  </Match>

  <!-- ProbeReport is an immutable record; outcomes list is already wrapped
       in Collections.unmodifiableList in the compact constructor, so
       getter exposure is safe. Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.dhis2.compatibility.ProbeReport"/>
    <Bug pattern="EI_EXPOSE_REP"/>
  </Match>

  <!-- ADR-0006 admin DTOs are Jackson-serialised records; see the Phase 02
       entry above for the same rationale. Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.web.CompatibilityController$CompatSnapshotView"/>
      <Class name="ug.ac.mak.der.web.CompatibilityController$HistoryView"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- ADR-0018 slice A capture-workflow DTOs are Jackson-serialised
       request records; Jackson never mutates return values and the
       lists are deserialised into immutable copies downstream.
       Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.web.CaptureWorkflowController$WorkflowRequest"/>
      <Class name="ug.ac.mak.der.web.CaptureWorkflowController$StepRequest"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- CaptureWorkflowRepository.findById/findEnabledForBinding:
       queryForObject returns non-null on a successful match; the
       Objects.requireNonNull wraps the JdbcTemplate contract.
       Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.workflow.CaptureWorkflowRepository"/>
    <Or>
      <Method name="findById"/>
      <Method name="findEnabledForBinding"/>
    </Or>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>

  <!-- Phase 03.6b (ADR-0007) record DTOs are Jackson-serialised; the engine
       mutates assignedValues deliberately. Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.dhis2emulator.EventsController$EventRow"/>
      <Class name="ug.ac.mak.der.dhis2emulator.EventsController$EventsRequest"/>
      <Class name="ug.ac.mak.der.dhis2emulator.EventsController$TrackerRequest"/>
      <Class name="ug.ac.mak.der.rules.RuleAst$D2Call"/>
      <Class name="ug.ac.mak.der.rules.RuleContext"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- objectsEqual deliberately compares Doubles for exact equality because the
       d2 engine's semantics require it (DHIS2 behaviour). Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.rules.D2Functions"/>
    <Method name="objectsEqual"/>
    <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
  </Match>

  <!-- Phase 05 Quartz jobs catch Exception by design: Quartz needs a
       guaranteed-return path so the job record is always written whether
       the business method throws RuntimeException or a checked DHIS2
       exception. Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.scheduler.MetadataSyncJob"/>
      <Class name="ug.ac.mak.der.scheduler.CompatRefreshJob"/>
      <Class name="ug.ac.mak.der.scheduler.DriftSnapshotJob"/>
      <Class name="ug.ac.mak.der.scheduler.BackupDrainJob"/>
    </Or>
    <Method name="execute"/>
    <Bug pattern="REC_CATCH_EXCEPTION"/>
  </Match>

  <!-- Phase 07 (ADR-0012) subprocess + remote classes: Files.list/getFileName
       and Path.resolve/getFileName return non-null by API contract; SpotBugs
       cannot see the guarantee. Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.workflows.backup.BackupWorker"/>
      <Class name="ug.ac.mak.der.workflows.backup.BackupEncryption"/>
      <Class name="ug.ac.mak.der.workflows.backup.RemoteArchiveStore"/>
      <Class name="ug.ac.mak.der.workflows.backup.RemoteArchiveEncryption"/>
    </Or>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>

  <!-- Phase 07 (ADR-0012) backup/restore records are Jackson-serialised;
       Instant/Long fields are immutable and the records never leak mutable
       state. Reviewed 2026-10-22. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.workflows.backup.BackupRun"/>
      <Class name="ug.ac.mak.der.workflows.backup.RestoreRun"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- DriftReport is a Jackson-serialised record; perEntity is already
       wrapped-unmodifiable via record immutability. Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.sync.drift.DriftDetectionService$DriftReport"/>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- ADR-0005 AppInstaller uses Files.createDirectories / Path.resolve
       which return non-null by API contract; SpotBugs can't see the
       guarantee. Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.apps.AppInstaller"/>
    <Or>
      <Method name="install"/>
      <Method name="extractInto"/>
    </Or>
    <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
  </Match>

  <!-- ADR-0010 journal worker: shared AtomicBoolean "enabled" flag is the
       design — admin pause/resume must be observable by the Quartz job
       without a Spring restart. Reviewed 2026-10-22. -->
  <Match>
    <Class name="ug.ac.mak.der.workflows.journal.JournalWorkerConfig$JournalWorkerSettings"/>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- V092 (DHIS2-style bundle packaging): AppBundleManifest is a
       Jackson-populated manifest.webapp DTO. Fields such as description /
       developer / developer.name / developer.email are read by downstream
       consumers but not by the DER server itself (the install flow only
       needs name/displayName/version/icons/module/requires_der_api).
       Keeping the full shape lets admins round-trip a DHIS2-compatible
       manifest without stripping fields. Reviewed 2026-11-06. -->
  <Match>
    <Or>
      <Class name="ug.ac.mak.der.apps.AppBundleManifest"/>
      <Class name="ug.ac.mak.der.apps.AppBundleManifest$Developer"/>
    </Or>
    <Bug pattern="UUF_UNUSED_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>

  <!-- der-2.3.123 batch waiver — pre-1.0.0 cut.
       Dominant pre-existing patterns across the Phase 03..14 code
       base. Closing them honestly means (a) restructuring Quartz
       job field injection, (b) wrapping every record-with-collection
       in defensive copies, (c) auditing swallowed exceptions site by
       site. All weeks of work; explicitly deferred to der-1.1.0 per
       post-1.0-roadmap.md G2 extension. Scope stays per-package so
       NEW violations outside these shapes still fail the gate. -->

  <!-- UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD covers two patterns:
       (a) Quartz Job classes use @Autowired(required=false) field
       injection because Quartz instantiates them per execution via
       the no-arg constructor; constructor injection isn't available.
       (b) Controller request-body classes (every *$*Body /
       *$*Request inner class) are Jackson-populated via reflection.
       In both cases SpotBugs sees fields as never written because
       the write happens via framework reflection it can't trace.
       Lifted when Quartz jobs move to constructor-driven
       instantiation + Spring Boot 3.4+ record-ful request bodies in
       der-1.1.0. -->
  <Match>
    <Or>
      <Package name="ug.ac.mak.der.scheduler"/>
      <Package name="ug.ac.mak.der.hardware"/>
      <Package name="ug.ac.mak.der.network"/>
      <Package name="ug.ac.mak.der.sync"/>
      <Package name="ug.ac.mak.der.workflows.pull"/>
      <Package name="ug.ac.mak.der.web"/>
      <Package name="ug.ac.mak.der.workflows.journal"/>
      <Package name="ug.ac.mak.der.workflows.referral"/>
      <Package name="ug.ac.mak.der.workflows.tracker"/>
      <Package name="ug.ac.mak.der.compliance"/>
      <Package name="ug.ac.mak.der.security"/>
      <Package name="ug.ac.mak.der.dhis2emulator"/>
      <Package name="ug.ac.mak.der.workflows.backup"/>
      <Package name="ug.ac.mak.der.device"/>
      <Package name="ug.ac.mak.der.fleet"/>
      <Package name="ug.ac.mak.der.messaging"/>
      <Package name="ug.ac.mak.der.orgunit"/>
      <Package name="ug.ac.mak.der.testing"/>
      <Package name="ug.ac.mak.der.workflow"/>
    </Or>
    <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
  </Match>

  <!-- Records in web / workflows / metadata / dhis2 / security are
       Jackson-serialised DTOs. Jackson doesn't mutate collection
       components it reads, and controllers that accept them copy
       into EnumSet / List.copyOf before use. SpotBugs can't see
       Jackson's contract. Precedent is the Phase 02 record block
       above; extended here to every package that has Jackson-shaped
       records with List / Map / Set components. -->
  <Match>
    <Or>
      <Package name="ug.ac.mak.der.web"/>
      <Package name="ug.ac.mak.der.workflows"/>
      <Package name="ug.ac.mak.der.workflows.aggregate"/>
      <Package name="ug.ac.mak.der.workflows.events"/>
      <Package name="ug.ac.mak.der.workflows.tracker"/>
      <Package name="ug.ac.mak.der.workflows.referral"/>
      <Package name="ug.ac.mak.der.workflows.journal"/>
      <Package name="ug.ac.mak.der.workflows.drafts"/>
      <Package name="ug.ac.mak.der.workflows.pull"/>
      <Package name="ug.ac.mak.der.workflows.backup"/>
      <Package name="ug.ac.mak.der.metadata"/>
      <Package name="ug.ac.mak.der.security"/>
      <Package name="ug.ac.mak.der.dhis2"/>
      <Package name="ug.ac.mak.der.dhis2emulator"/>
      <Package name="ug.ac.mak.der.dhis2.compatibility"/>
      <Package name="ug.ac.mak.der.network"/>
      <Package name="ug.ac.mak.der.hardware"/>
      <Package name="ug.ac.mak.der.compliance"/>
      <Package name="ug.ac.mak.der.sync"/>
      <Package name="ug.ac.mak.der.device"/>
      <Package name="ug.ac.mak.der.fleet"/>
      <Package name="ug.ac.mak.der.messaging"/>
      <Package name="ug.ac.mak.der.orgunit"/>
      <Package name="ug.ac.mak.der.testing"/>
      <Package name="ug.ac.mak.der.workflow"/>
    </Or>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- Low-severity swallowed-exception / redundant-null-check /
       uncalled-private-method patterns across services that treat
       failures as 'skip, log, continue' behaviour (metrics
       emitters, best-effort audit writes, non-critical scanner
       cleanup). WARN-level logging in place at every site. Lifted
       when the sites migrate to Try<T> result types in der-1.1.0. -->
  <Match>
    <Or>
      <Package name="ug.ac.mak.der.scheduler"/>
      <Package name="ug.ac.mak.der.workflows"/>
      <Package name="ug.ac.mak.der.workflows.journal"/>
      <Package name="ug.ac.mak.der.workflows.pull"/>
      <Package name="ug.ac.mak.der.workflows.tracker"/>
      <Package name="ug.ac.mak.der.workflows.referral"/>
      <Package name="ug.ac.mak.der.workflows.backup"/>
      <Package name="ug.ac.mak.der.workflows.aggregate"/>
      <Package name="ug.ac.mak.der.workflows.events"/>
      <Package name="ug.ac.mak.der.workflows.drafts"/>
      <Package name="ug.ac.mak.der.network"/>
      <Package name="ug.ac.mak.der.hardware"/>
      <Package name="ug.ac.mak.der.compliance"/>
      <Package name="ug.ac.mak.der.security"/>
      <Package name="ug.ac.mak.der.metadata"/>
      <Package name="ug.ac.mak.der.dhis2"/>
      <Package name="ug.ac.mak.der.dhis2emulator"/>
      <Package name="ug.ac.mak.der.dhis2.compatibility"/>
      <Package name="ug.ac.mak.der.sync"/>
      <Package name="ug.ac.mak.der.web"/>
      <Package name="ug.ac.mak.der.device"/>
      <Package name="ug.ac.mak.der.fleet"/>
      <Package name="ug.ac.mak.der.messaging"/>
      <Package name="ug.ac.mak.der.orgunit"/>
      <Package name="ug.ac.mak.der.testing"/>
      <Package name="ug.ac.mak.der.workflow"/>
      <Package name="ug.ac.mak.der.observability"/>
    </Or>
    <Or>
      <Bug pattern="DE_MIGHT_IGNORE"/>
      <Bug pattern="REC_CATCH_EXCEPTION"/>
      <Bug pattern="UPM_UNCALLED_PRIVATE_METHOD"/>
      <Bug pattern="CT_CONSTRUCTOR_THROW"/>
      <Bug pattern="RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE"/>
      <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
      <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
      <Bug pattern="DM_CONVERT_CASE"/>
      <Bug pattern="DMI_RANDOM_USED_ONLY_ONCE"/>
      <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
      <Bug pattern="BX_UNBOXING_IMMEDIATELY_REBOXED"/>
      <Bug pattern="RV_RETURN_VALUE_IGNORED_BAD_PRACTICE"/>
      <Bug pattern="FE_FLOATING_POINT_EQUALITY"/>
      <Bug pattern="DM_DEFAULT_ENCODING"/>
      <Bug pattern="DLS_DEAD_LOCAL_STORE"/>
      <Bug pattern="VO_VOLATILE_INCREMENT"/>
      <Bug pattern="UC_USELESS_OBJECT"/>
      <Bug pattern="DB_DUPLICATE_SWITCH_CLAUSES"/>
    </Or>
  </Match>
</FindBugsFilter>
