{
  "name": "der-admin-ui",
  "version": "2.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@atlaskit/button": "^25.6.0",
    "@atlaskit/css-reset": "^8.4.6",
    "@atlaskit/form": "^18.2.1",
    "@atlaskit/heading": "^8.0.0",
    "@atlaskit/icon": "^38.0.2",
    "@atlaskit/menu": "^11.0.4",
    "@atlaskit/page-layout": "^5.5.7",
    "@atlaskit/section-message": "^10.2.6",
    "@atlaskit/side-navigation": "^13.3.8",
    "@atlaskit/spinner": "^20.4.4",
    "@atlaskit/textfield": "^10.2.6",
    "@atlaskit/tokens": "^20.7.0",
    "@dhis2/ui": "^10.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.48.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.9.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.15",
    "vitest": "^2.1.9"
  }
}
