# DER local development environment template.
#
# Copy this file to `.env.local` and fill in the real values. `.env.local` is
# gitignored. All secrets below are per-host and MUST NOT be committed.
#
# Usage:
#   set -a; source .env.local; set +a; cd server && ./mvnw spring-boot:run
# or feed into the Phase 02 gate step:
#   set -a; source .env.local; set +a; bash scripts/run_all_checks.sh

# ----- Database -----------------------------------------------------------
# DER coordination database on the local Postgres 17 instance (ADR-0003).
# The password is a per-host dev value; Phase 06 introduces rotation.
DER_DB_URL=jdbc:postgresql://localhost:5432/der
DER_DB_USERNAME=der
DER_DB_PASSWORD=der_phase01_devonly

# ----- Session secret -----------------------------------------------------
# 384-bit random, base64-encoded. Generate with:
#   openssl rand -base64 48
# Rotating the secret invalidates every existing DER session.
DER_SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_48

# §2.3.42 — AES-256-GCM key for the peer-registry service-account
# password at rest. Falls back to an insecure dev-only key when empty;
# every pilot MUST set this.
#   openssl rand -base64 48
DER_PEER_SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_48

# How long an issued session cookie remains valid (ISO-8601 duration).
DER_SESSION_TTL=PT4H
# Session cookie flags. SameSite=Strict matches a cookie-only API with no
# cross-origin needs. If you later deploy admin and client on separate
# origins, revisit this to SameSite=Lax.
DER_SESSION_COOKIE_SAMESITE=Strict
DER_SESSION_COOKIE_SECURE=false

# ----- Bootstrap admin ----------------------------------------------------
# On first boot, if no DER user with role=ADMIN exists AND these are set, DER
# provisions a single administrator. The verifier is Argon2id-hashed before
# storage; the plaintext is never persisted. Clear these after bootstrap to
# avoid repeated audit log noise.
DER_BOOTSTRAP_ADMIN_USERNAME=der-admin
DER_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LONG_PASSPHRASE

# ----- DHIS2 (Phase 01+) --------------------------------------------------
DER_DHIS2_CENTRAL_URL=http://localhost:8080/dhis
DER_DHIS2_USER=admin
DER_DHIS2_PASSWORD=district

# ----- Optional Phase 02 toggles ------------------------------------------
# When true, DER accepts an observed DHIS2 version that does not match the
# pinned prefix. Dev-only; MUST be false in release config.
DER_DHIS2_ALLOW_MISMATCH=false
# When true, run_all_checks.sh executes the gated integration tests against
# the live DER_DB_URL (otherwise they are reported as NOT RUN).
DER_RUN_INTEGRATION_TESTS=true
